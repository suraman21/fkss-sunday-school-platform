new file mode 100644
index 0000000..d518c83
--- /dev/null
+++ b/src/Support/HttpException.php
@@ -0,0 +1,42 @@
+<?php
+declare(strict_types=1);
+
+namespace MembersPortal\Support;
+
+use RuntimeException;
+
+/**
+ * An error that carries an HTTP status and a message safe to show a user.
+ *
+ * Why this exists in the skeleton: it is the type every layer will throw
+ * across a boundary. Anything that is NOT this class is an internal failure
+ * — logged, and answered with a generic message. Keeping the two apart is
+ * what makes "did I mean to show this text to a member?" a decision rather
+ * than an accident.
+ *
+ * Statuses used so far: 404 (no such page), 500 (unexpected).
+ */
+final class HttpException extends RuntimeException
+{
+    private int $status;
+
+    /** Extra public fields (e.g. a machine-readable code). Never diagnostics. */
+    private array $publicPayload;
+
+    public function __construct(int $status, string $message, array $publicPayload = [])
+    {
+        parent::__construct($message);
+        $this->status = $status;
+        $this->publicPayload = $publicPayload;
+    }
+
+    public function status(): int
+    {
+        return $this->status;
+    }
+
+    public function publicPayload(): array
+    {
+        return $this->publicPayload;
+    }
+}
diff --git a/src/Support/bootstrap.php b/src/Support/bootstrap.php
new file mode 100644
index 0000000..094d8df
--- /dev/null
+++ b/src/Support/bootstrap.php
@@ -0,0 +1,25 @@
+<?php
+/**
+ * Members web app — bootstrap.
+ *
+ * This is the ONLY file that loads anything, and it exists for one reason:
+ * the deployment host has no Composer (ADR-0001), so first-party classes are
+ * listed here by hand, in dependency order.
+ *
+ * Nothing else is wired yet. There is no configuration, no database, no
+ * session and no HTTP entry point: the application has no behaviour, so this
+ * file has nothing to start.
+ *
+ * HOW TO ADD A CLASS
+ *   1. create the file under src/
+ *   2. add one require_once line below, in dependency order
+ *   3. keep the dependency direction one-way: Http -> Service -> Repository
+ *
+ * Paths are written as __DIR__ . '/…' so that a static include check can
+ * resolve them. A path built from a constant reads as "dynamic" to such a
+ * check and needs a permanent allowlist entry.
+ */
+
+declare(strict_types=1);
+
+require_once __DIR__ . '/HttpException.php';
