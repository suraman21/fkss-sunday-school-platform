<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- P0 background mezmur playback (just_audio_background / audio_service) -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <!-- Target SDK 34+: media playback foreground-service type. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <!-- P7 photo sync: dataSync foreground-service type (Android 14+). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <!-- Android 13+: media-session notifications are exempt, but declaring
         the runtime-notification permission keeps the shutter visible on
         devices where the exemption is not applied. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- QR-scan attendance taking (Phase 8): camera is used only by the
         in-app scanner (on-device decode, no images leave the phone). -->
    <!-- Pre-Android-10 only: the MediaStore Downloads insert needs this
         on API 28 and below. API 29+ saves to Downloads/FKSS with no
         permission at all. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- App Lock: fingerprint/face unlock (local_auth) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="FKSS Beta"
        android:name=".FkssApplication"
        android:icon="@mipmap/launcher_icon"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- P0 background audio: the service keeps playing + exposes the
             media notification / lock-screen transport while the app is in
             the background. MainActivity subclasses
             AudioServiceFragmentActivity (see MainActivity.kt) so the Flutter
             engine that owns the player stays bound to this service.
             exported="false": the service is only ever bound from inside
             this process. Exporting it (the template default) would let any
             app on the device connect to the MediaBrowserService and drive
             the media session. Media-button intents arrive through the
             separate MediaButtonReceiver below, which does need exporting. -->
        <service
            android:name="com.ryanheise.audioservice.AudioService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
        <receiver
            android:name="com.ryanheise.audioservice.MediaButtonReceiver"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>
        <!--
            P7 — photo sync foreground service. Holds the process in the
            "started" state while the Dart PhotoSyncWorker drains the
            outbox so Android doesn't kill multi-megabyte uploads when
            the screen is off. Exported=false so only this app can
            bind/start it.
        -->
        <service
            android:name=".PhotoSyncForegroundService"
            android:foregroundServiceType="dataSync"
            android:exported="false"
            tools:ignore="Instantiatable" />
        <receiver
            android:name=".PhotoSyncActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.arkeonethiopia.fkss.action.STOP_PHOTO_SYNC" />
            </intent-filter>
        </receiver>

        <!--
            S3 A.8 — the background sync wake-up.

            exported="false": nothing outside this app may trigger a sync.
            No new permission is required for this receiver or for the
            inexact setAndAllowWhileIdle alarm that drives it; in particular
            SCHEDULE_EXACT_ALARM and RECEIVE_BOOT_COMPLETED are deliberately
            NOT requested. See BackgroundSyncProducer for why reboot
            reconstruction would buy nothing for this mechanism.
        -->
        <receiver
            android:name=".BackgroundSyncReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.arkeonethiopia.fkss.action.BACKGROUND_SYNC" />
            </intent-filter>
        </receiver>

        <!--
            Adaptive photo-capture framing: bundle the ML Kit face and
            pose models into the APK at build time so the framing guide
            works fully offline (no Google Play model download at first
            use, which requires connectivity the field does not have).
        -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="face,pose" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:mimeType="application/vnd.android.package-archive"/>
        </intent>
    </queries>
</manifest>
