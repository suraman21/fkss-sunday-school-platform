# P0 search engine: index files contain member PII tokens — never serve them.
# NOTE: Apache-only. Nginx deployments MUST replicate with `deny all;`
# for /admin/var/ — see docs/OPERATIONS.md — or index content goes public.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order Allow,Deny
    Deny from all
</IfModule>
